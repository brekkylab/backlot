{"source_type": "github", "doc_id": "gh-gateway-limiter-py", "repo": "gateway", "group": "engineering", "subtype": "file", "path": "gateway/limiter.py", "title": "gateway/limiter.py", "content": "class TokenBucket:\n    \"\"\"Refills at `rate` tokens/sec, capped at `burst`.\"\"\"\n\n    def __init__(self, rate, burst):\n        self.rate = rate\n        self.burst = burst\n", "author_email": "bob@acme.com", "author_name": "Bob Ito", "author_groups": ["engineering"], "created": "2026-01-20T09:00:00Z", "updated": "2026-02-10T12:00:00Z", "visibility": "public"}
{"source_type": "github", "doc_id": "gh-gateway-limiter-py-418", "repo": "gateway", "group": "engineering", "subtype": "file", "path": "gateway/limiter.py", "ref": "pr-418", "title": "gateway/limiter.py", "content": "class TokenBucket:\n    \"\"\"Refills at `rate` tokens/sec, capped at `burst`.\"\"\"\n\n    def __init__(self, rate, burst):\n        self.rate = rate\n        self.burst = burst\n        self.tokens = burst\n\n    def refill(self, elapsed):\n        # clamp against `burst`, the cap -- not against `tokens` (see review on #418)\n        self.tokens = min(self.burst, self.tokens + self.rate * elapsed)\n", "author_email": "bob@acme.com", "author_name": "Bob Ito", "author_groups": ["engineering"], "created": "2026-02-10T12:00:00Z", "visibility": "public"}
